{
  "name": "ai-test-workflow-revflow",
  "version": "1.0.0",
  "description": "RevFlow Playwright automation suite (JavaScript / @playwright/test)",
  "scripts": {
    "clean:reports": "node -e \"const fs=require('fs');['reports/allure-results','reports/allure-report','allure-results','test-results'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "pretest": "npm run clean:reports",
    "pretest:headed": "npm run clean:reports",
    "pretest:chromium": "npm run clean:reports",
    "pretest:firefox": "npm run clean:reports",
    "pretest:webkit": "npm run clean:reports",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report reports/html",
    "allure:generate": "allure generate reports/allure-results --clean --output reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "install:browsers": "playwright install --with-deps"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2"
  }
}
