{
  "name": "ai-test-workflow-revflow",
  "version": "1.0.0",
  "description": "RevFlow Playwright automation suite (JavaScript / @playwright/test)",
  "scripts": {
    "test": "playwright test & npm run allure:serve",
    "test:headed": "playwright test --headed & npm run allure:serve",
    "test:chromium": "playwright test --project=chromium & npm run allure:serve",
    "test:firefox": "playwright test --project=firefox & npm run allure:serve",
    "test:webkit": "playwright test --project=webkit & npm run allure:serve",
    "report": "playwright show-report",
    "allure:generate": "allure generate reports/allure-results --clean --output reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "install:browsers": "playwright install --with-deps"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2"
  }
}
